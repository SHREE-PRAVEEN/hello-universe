DATABASE_URL=postgres://shreepraveen:Shreepraveen%4023@localhost:5432/hello_universe

# Auth
JWT_SECRET=change_this_to_a_long_random_strin

# PayU (test credentials from https://onboarding.payu.in — replace for production)
PAYU_MERCHANT_KEY=your_payu_test_key
PAYU_MERCHANT_SALT=your_payu_test_salt
PAYU_BASE_URL=https://test.payu.in/_payment
PAYU_SUCCESS_URL=http://localhost:8080/api/payu/success
PAYU_FAILURE_URL=http://localhost:8080/api/payu/failure

# SMTP (for delivering purchased software by email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=no-reply@hellouniverse.dev

# Frontend (used for PayU post-payment redirects)
FRONTEND_URL=http://localhost:3000

# Backend's own public URL — used to build the NOWPayments webhook callback.
# Must be reachable from the internet in production (NOWPayments needs to
# POST to it); use ngrok or similar for local testing.
BACKEND_PUBLIC_URL=http://localhost:8080

# NOWPayments (crypto gateway) — https://nowpayments.io
# Sign up, create an API key, and set up an IPN secret in your dashboard.
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# Self-hosted USDT-TRC20 — payments go straight to your own wallet, verified
# on-chain via TronGrid (no third party account required). Leave
# USDT_TRC20_WALLET_ADDRESS empty to disable this payment method.
USDT_TRC20_WALLET_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Optional but recommended — free at https://www.trongrid.io — avoids the
# stricter unauthenticated rate limit.
TRONGRID_API_KEY=518af17d-9300-4ce6-8f1a-4398ba5a58b4
TRONGRID_BASE_URL=https://api.trongrid.io
# USDT's official TRC-20 contract on Tron mainnet (rarely needs changing).
USDT_TRC20_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
